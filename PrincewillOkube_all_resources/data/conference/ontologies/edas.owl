  </rdf:Description>
  <rdf:Description rdf:about="http://edas#Conference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Conference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://edas#Reviewer">
